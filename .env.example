# Copy to .env for local development. Never commit the real .env file.

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Local dev only. In production on Cloud Run, leave unset and attach a
# runtime service account with least-privilege roles instead.
GOOGLE_APPLICATION_CREDENTIALS=

GCS_BUCKET_NAME=your-audio-staging-bucket
GCS_SIGNED_URL_EXPIRY_SECONDS=3600

SPEECH_RECOGNIZER_ID=_
SPEECH_LANGUAGE_CODES=en-US
SPEECH_MODEL=long
ENABLE_SPEAKER_DIARIZATION=true
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=2

VERTEX_MODEL_NAME=gemini-2.5-pro
VERTEX_MAX_OUTPUT_TOKENS=8192
VERTEX_TEMPERATURE=0.2
VERTEX_TOP_P=0.95
VERTEX_REQUEST_TIMEOUT_SECONDS=120
VERTEX_MAX_RETRIES=3

MAX_AUDIO_SIZE_MB=200
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,flac

APP_ENV=development
LOG_LEVEL=INFO
API_KEY=
CORS_ALLOW_ORIGINS=*
